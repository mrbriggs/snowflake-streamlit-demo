# .streamlit/secrets.toml.example
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .streamlit/secrets.toml and fill in your values.
# secrets.toml is listed in .gitignore — never commit real credentials.
#
# ACCOUNT FORMAT: use the dash-separated org-account form, e.g.
#   myorg-myaccount
# NOT the legacy dot form (myorg.myaccount) — st.connection("snowflake")
# requires the dash-separated identifier.
# ─────────────────────────────────────────────────────────────────────────────

[connections.snowflake]
account   = "orgname-account_name"    # e.g. "acme-prod123"  (dash-separated!)
user      = "your_snowflake_username"
password  = "your_password"           # or use private_key_file below instead

# Key-pair auth (optional — comment out password above if using this)
# private_key_file = "/path/to/rsa_key.p8"
# private_key_file_pwd = ""           # passphrase, or leave empty if unencrypted

role      = "STREAMLIT_DEMO_ROLE"
warehouse = "DEMO_WH"
database  = "CYBER_DEMO"
schema    = "PUBLIC"
